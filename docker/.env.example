# Copy to docker/.env and fill in. Compose reads this automatically.
# Never commit the real docker/.env.

# Host ports. Change these if something else already uses them locally.
FRONTEND_PORT=8080
BACKEND_PORT=3000
DB_PORT_HOST=5432
REDIS_PORT_HOST=6379

# Local observability. Logs remain on the host for 30 days; Grafana is bound
# to loopback only. Generate a unique password before starting the profile.
WOW_LOG_DIR=../logs
GRAFANA_PORT=3300
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
LOKI_ENDPOINT=http://loki:3100
LOG_RETENTION_DAYS=30
LOG_DISK_WARNING_PERCENT=80
LOG_DISK_ERROR_PERCENT=90

# The local compose stack deliberately permits mock/log providers even though
# the Node runtime is production-optimized. Railway/public deployments must
# explicitly select public-beta or revenue and pass the fail-closed boot policy.
DEPLOYMENT_TIER=local
SERVICE_NAME=backend
RELEASE=unknown
TEST_DELIVERY_CAPTURE_ENABLED=false
TEST_DELIVERY_CAPTURE_KEY=

DB_USER=wow_user
DB_PASSWORD=change-me-strong-db-password
DB_NAME=wow_db

# Must be at least 32 characters. Generate with:
#   openssl rand -hex 32
JWT_SECRET=change-me-in-production-min-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-in-production-min-32-chars

# Browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:8080   # must match FRONTEND_PORT

# Mail. 'log' writes invitation/reset links to the backend log, which is enough
# for local use. Set MAIL_PROVIDER=smtp plus SMTP_* to send for real.
MAIL_PROVIDER=log
MAIL_FROM=WOW <no-reply@wow.local>
APP_BASE_URL=http://localhost:8080   # must match FRONTEND_PORT
MFA_REQUIRED_FOR_ADMIN=false
ADMIN_LOGIN_PROVIDER=password
ZOHO_SSO_ENABLED=false
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=

# HMAC secret for payment-gateway webhooks.
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret

# Business switches.
#   INDIVIDUAL_USER_ENABLED=false  -> agent-only brokerage; nobody self-registers
#                                     for matchmaking. Existing accounts keep working.
#   SERVICES_REQUIRE_MATCH_FIXED=true  -> the wedding marketplace waits for a
#                                     fixed match. Off by default: a match fixed
#                                     outside the platform is still a wedding to
#                                     buy, and the bookings are the revenue.
#   MATCHMAKING_REQUIRES_IDENTITY=false  -> identity verification no longer
#                                     gates sending, accepting or fixing an
#                                     interest. On by default; browsing is open
#                                     either way.
INDIVIDUAL_USER_ENABLED=true
SERVICES_REQUIRE_MATCH_FIXED=false
MATCHMAKING_REQUIRES_IDENTITY=true
CHAT_REDACT_CONTACTS=true

# Push notifications. `log` writes what would have been sent to the application
# log, so nothing needs a Firebase project to run.
#   PUSH_PROVIDER=fcm  -> Firebase Cloud Messaging; PUSH_SERVER_KEY is required.
PUSH_PROVIDER=log
PUSH_SERVER_KEY=

# WhatsApp. Opt-in only, and template-only: a business-initiated message has to
# be one of the templates the number has had approved by Meta and, in India,
# registered under DLT. The platform registers the few worth interrupting
# somebody for — booking_request, booking_quotation, booking_payment,
# booking_completed, verification_decided — and everything else stays in the app.
#   WHATSAPP_PROVIDER=cloud -> Meta Cloud API; token and phone number id required.
WHATSAPP_PROVIDER=log
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_LANGUAGE=en

# Recommendations are shown above this compatibility score.
MATCH_MIN_SCORE=50

# Escrow instalments, as percentages of the booking total. Must add to 100 —
# the API refuses to start otherwise.
ESCROW_ADVANCE_PERCENT=30
ESCROW_SECOND_PERCENT=30
ESCROW_FINAL_PERCENT=40

# What an agency charges, in rupees: onboarding a client, and the success fee
# that falls due when their match is fixed.
AGENT_PROFILE_FEE=2000
AGENT_SETTLEMENT_FEE=25000

# Bootstrap administrator. ADMIN accounts cannot be created through the public
# API, so seed the first one with:
#   docker compose -f docker/docker-compose.yml --profile seed run --rm seed-admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-min-12-characters

# Local interface testing only: one account per role, demo.<role>@wow.local,
# all sharing this password (12+ characters). Leave empty anywhere shared.
#   docker compose -f docker/docker-compose.yml --profile seed run --rm seed-demo
DEMO_PASSWORD=

# Android test build (docker compose --profile mobile run --rm build-android).
# MOBILE_API_URL is baked into the APK. A signing key is optional: put it at
# docker/android-keys/release.jks and set its alias and password here.
MOBILE_API_URL=https://test.worldofweddingz.com/api
ANDROID_KEY_ALIAS=upload
ANDROID_KEYSTORE_PASSWORD=
# Canonical non-secret defaults are in ../config/platform.yaml. Override only
# declared scalar settings here; keep credentials in this ignored .env file.
PLATFORM_CONFIG_PATH=/app/config/platform.yaml
